generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique @db.VarChar(30)
  email            String    @unique @db.VarChar(50)
  phone            String?   @db.VarChar(15)
  password         String    @db.Text
  isVerified       Boolean   @default(false)
  resetToken       String?   @db.Text
  resetTokenExpiry DateTime?
  otp              String?   @db.VarChar(6)
  otpExpiresAt     DateTime?
  addresses        Address[]
  orders           Order[]
}

model Address {
  id       Int    @id @default(autoincrement())
  label    String @default("Home") @db.VarChar(20)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  street   String @db.VarChar(100)
  area     String @db.VarChar(100)
  district String @db.VarChar(50)
  state    String @db.VarChar(50)
  pinCode  String @db.VarChar(10)
  country  String @db.VarChar(50)
}

model Order {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  total          Int
  status         String   @default("Pending") @db.VarChar(20)
  items          Json
  paymentMethod  String?  @db.VarChar(20)
  paymentDetails Json?
  trackingId     String?  @unique @db.VarChar(50)
  createdAt      DateTime @default(now())
}

model Item {
  id          Int     @id @default(autoincrement())
  category    String  @db.VarChar(20)
  item_name   String  @db.VarChar(50)
  price       Int
  image_url   String?
  isavailable Boolean @default(true)
  iskilo      Boolean @default(true)
  isbill      Boolean @default(false)
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  email     String   @db.VarChar(50)
  subject   String?  @db.VarChar(100)
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Bill {
  id          Int      @id @default(autoincrement())
  items       Json // Array of {itemId, itemName, quantity, price, subtotal}
  totalAmount Int
  paymentMode String   @default("Cash") @db.VarChar(20) // Cash, UPI, Card
  createdAt   DateTime @default(now())
}

model Employee {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(50)
  phone       String?      @unique @db.VarChar(15)
  role        String       @default("Staff") @db.VarChar(30)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  attendances Attendance[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @default(now())
  status     String   @default("PRESENT") @db.VarChar(20) // PRESENT, ABSENT, HALF_DAY
}

model AdminProfile {
  id            Int    @id @default(autoincrement())
  business_name String
  address       String

  gstin          String?
  phone          String?
  whatsapp       String?
  business_email String?

  smtp_email     String?
  smtp_password  String?
  order_receiver String?

  instagram_url String?
  facebook_url  String?

  frontend_logo String?
  backend_logo  String?
  business_logo String?

  Collections_image String?
  OurStory_image    String?
  cod_limit         Int?    @default(1000)

  upi_id      String?
  upi_message String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(20)
  discountType  String   @db.VarChar(10) // "percentage" or "fixed"
  discountValue Float
  minOrderValue Float    @default(0)
  expiryDate    DateTime
  usageLimit    Int?     @default(1)
  usedCount     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updated_at    DateTime @updatedAt
}

